# ============================================================
#  VISIONTRUST — Environment Variables Template
#  Copy this to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=visiontrust
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=visiontrust

# Async URL used by the FastAPI app at runtime
DATABASE_URL=postgresql+asyncpg://visiontrust:change_me_strong_password@localhost:5432/visiontrust

# Sync URL used by Alembic migrations only
DATABASE_SYNC_URL=postgresql+psycopg2://visiontrust:change_me_strong_password@localhost:5432/visiontrust

# ── JWT ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=replace_with_64_byte_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Ed25519 Signing Keys ──────────────────────────────────
# Store as file paths OR base64-encoded bytes
PRIVATE_KEY_PATH=
PUBLIC_KEY_PATH=
ED25519_PRIVATE_KEY_B64=
ED25519_PUBLIC_KEY_B64=

# ── Application ───────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# ── Security ──────────────────────────────────────────────
# First admin user (created on startup if no users exist)
FIRST_ADMIN_EMAIL=admin@visiontrust.local
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change_me_admin_password
